{
  "name": "auto-apply-for-positions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "track": "node src/app/tracker.ts",
    "launchd:install": "node scripts/install-launchd.ts",
    "launchd:uninstall": "launchctl bootout gui/$(id -u)/local.job-tracker; rm -f ~/Library/LaunchAgents/local.job-tracker.plist",
    "launchd:status": "launchctl print gui/$(id -u)/local.job-tracker",
    "logs": "tail -f logs/tracker.log logs/tracker.err.log | pino-pretty",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/utils": "^8.72.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
